output "kubeconfig" {
  description = "Kubernetes kubeconfig"
  value       = module.talos.kubeconfig
  sensitive   = true
}

output "talosconfig" {
  description = "Talos client configuration"
  value       = module.talos.talosconfig
  sensitive   = true
}

output "talos_installer_image" {
  description = "Secure Boot installer image generated by Talos Image Factory"
  value       = data.talos_image_factory_urls.this.urls.installer_secureboot
}
